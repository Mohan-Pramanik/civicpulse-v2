# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────
MONGO_URI=mongodb://localhost:27017/civicpulse

# ── JWT ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_256bit
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── File Upload ──────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ── Email (Nodemailer) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@civicpulse.in
FROM_NAME=CivicPulse

# ── Frontend URL (for CORS) ──────────────
CLIENT_URL=http://localhost:3000

# ── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
