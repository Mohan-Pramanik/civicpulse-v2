# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────
MONGO_URI=mongodb://localhost:27017/civicpulse

# ── JWT ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_256bit
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── File Upload ──────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ── Email (Nodemailer) ───────────────────
RESEND_API_KEY=re_3kP9MkWs_Btp5PGNSjjEmVfMez7NusV3E 
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=CivicPulse

# ── Frontend URL (for CORS) ──────────────
CLIENT_URL=http://localhost:3000

# ── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ── SMS OTP — Fast2SMS (https://fast2sms.com) ────────────────
# Sign up → Dashboard → Dev API → copy the API key below
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Google OAuth ─────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised JavaScript origins: http://localhost:3000
# Authorised redirect URIs: http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here